# ==============================================================================
# Required
# ==============================================================================

# Your bot's token, from https://discord.com/developers/applications
# (Bot -> Reset Token). Keep it secret; anyone holding it controls the bot.
DISCORD_BOT_TOKEN=

# The public HTTPS URL that YouTube's hub can reach. It must terminate TLS and
# forward to this container. Without it you get no push notifications — the
# feed poller still works, so uploads arrive within POLL_INTERVAL_MS instead of
# within seconds.
#
# Leave blank if you have no public URL; everything else keeps working.
WEBSUB_CALLBACK_BASE_URL=

# Shared secrets for the callback. Generate with:
#   openssl rand -hex 24     (verify token)
#   openssl rand -hex 48     (secret)
# Required whenever WEBSUB_CALLBACK_BASE_URL is set.
WEBSUB_VERIFY_TOKEN=
WEBSUB_SECRET=

# ==============================================================================
# Discord login (optional but strongly recommended if the dashboard is reachable
# by anyone but you)
# ==============================================================================
# With both of these set, the dashboard requires signing in with Discord and
# each person only sees the servers where they hold Manage Server.
# Leave them blank and the dashboard is OPEN to anyone who can reach it — fine
# on a trusted LAN, never on the public internet.
#
# From the same application page: OAuth2 -> Client ID / Client Secret.
# Add "<PUBLIC_BASE_URL>/api/auth/callback" under OAuth2 -> Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where the dashboard is reached from a browser. Used to build the OAuth
# redirect, so it must match the redirect you registered with Discord exactly.
PUBLIC_BASE_URL=http://localhost:8080

# ==============================================================================
# Optional
# ==============================================================================

# HTTP port inside the container.
PORT=8080

# Where the SQLite database lives. Keep it on a volume.
DATABASE_PATH=/data/herald.db

# Bot presence. Type: playing | streaming | listening | watching | competing
BOT_ACTIVITY_TYPE=watching
BOT_STATUS_TEXT=for new uploads
BOT_ONLINE_STATUS=online

# How often the RSS fallback checks every watched channel, in milliseconds.
# Set to 0 to rely on push alone (not recommended).
POLL_INTERVAL_MS=300000

# Most notifications one channel may post per poll pass, so a long outage
# cannot dump a wall of messages into a server.
POLL_MAX_PER_PASS=3

# debug | info | warn | error
LOG_LEVEL=info

# Only needed when migrating a pre-1.0 single-server database: the Discord
# server that the existing channels belong to.
# DISCORD_GUILD_ID=
